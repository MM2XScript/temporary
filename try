-- Enhanced networking and movement
task.spawn(function()
    local Network = ReplicatedStorage:WaitForChild("Network", 10)
    
    if not Network then
        warn("Network folder not found")
        return
    end

    -- Movement system
    task.spawn(function()
        local lastMoveTime = 0
        
        while task.wait(0.4) do
            pcall(function()
                if Config.HopEnabled and not State.IsHopping and not State.IsBooting and State.TargetPart then
                    local character = LocalPlayer.Character
                    if character and character:FindFirstChild("HumanoidRootPart") then
                        local hrp = character.HumanoidRootPart
                        local currentTime = tick()
                        
                        if currentTime - lastMoveTime > 0.3 then
                            local targetPos = State.TargetPart.CFrame * CFrame.new(0, 8, 0)
                            local distance = (hrp.Position - targetPos.Position).Magnitude
                            
                            if distance > 8 then 
                                hrp.CFrame = targetPos 
                                lastMoveTime = currentTime
                            end
                        end
                    end
                end
            end)
        end
    end)

    -- Damage dealing system
    task.spawn(function()
        local lastDamageTime = 0
        
        while task.wait(0.08) do
            pcall(function()
                if Config.HopEnabled and not State.IsHopping and not State.IsBooting and State.TargetId then
                    local currentTime = tick()
                    
                    if currentTime - lastDamageTime > 0.05 then
                        local dealDamage = Network:FindFirstChild("Breakables_PlayerDealDamage")
                        if dealDamage then
                            if dealDamage:IsA("RemoteEvent") then 
                                dealDamage:FireServer(State.TargetId)
                            elseif dealDamage:IsA("RemoteFunction") then 
                                pcall(function() dealDamage:InvokeServer(State.TargetId) end)
                            end
                        end
                        
                        local join = Network:FindFirstChild("Breakables_Join")
                        if join then
                            if join:IsA("RemoteEvent") then 
                                join:FireServer(State.TargetId)
                            elseif join:IsA("RemoteFunction") then 
                                pcall(function() join:InvokeServer(State.TargetId) end)
                            end
                        end
                        
                        lastDamageTime = currentTime
                    end
                end
            end)
        end
    end)
end)

-- Performance monitoring
task.spawn(function()
    while task.wait(30) do
        local currentTime = tick()
        
        local cacheSize = 0
        local oldEntries = {}
        
        for key, data in pairs(BlockCache) do
            cacheSize = cacheSize + 1
            if currentTime - data.time > CacheTimeout * 5 then
                table.insert(oldEntries, key)
            end
        end
        
        for _, key in ipairs(oldEntries) do
            BlockCache[key] = nil
        end
        
        if cacheSize > 200 then
            collectgarbage("collect")
        end
    end
end)

