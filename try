-- Enhanced server hopping function
local function HopServer()
    if State.IsHopping then return end
    State.IsHopping = true
    State.HopAttempts = State.HopAttempts + 1
    
    StatusLabel.Text = "Finding optimal server..."
    StatusLabel.TextColor3 = Color3.fromRGB(138, 43, 226)
    
    task.spawn(function()
        local success, result = pcall(function()
            local httpreq = (request or http_request or syn and syn.request)
            local url = string.format(
                "https://games.roblox.com/v1/games/%s/servers/0?sortOrder=Asc&excludeFullGames=true&limit=100", 
                tostring(PlaceId)
            )
            
            local response
            if httpreq then
                response = httpreq({Url = url, Method = "GET"})
                return HttpService:JSONDecode(response.Body)
            else
                return HttpService:JSONDecode(game:HttpGet(url))
            end
        end)

        if success and result and result.data then
            local validServers = {}
            
            for _, server in ipairs(result.data) do
                if type(server) == "table" and 
                   server.id ~= JobId and 
                   server.playing and 
                   server.playing >= Config.MinPlayers and 
                   server.playing <= Config.MaxPlayers then
                    table.insert(validServers, {id = server.id, players = server.playing})
                end
            end
            
            if #validServers > 0 then
                table.sort(validServers, function(a, b) return a.players < b.players end)
                
                State.TotalHops = State.TotalHops + 1
                StatusLabel.Text = "Teleporting to new server..."
                StatusLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
                
                local targetServer = validServers[math.min(3, #validServers)]
                pcall(function() 
                    TeleportService:TeleportToPlaceInstance(PlaceId, targetServer.id, LocalPlayer) 
                end)
                
                task.wait(6)
                State.IsHopping = false
                return
            end
        end
        
        local retryDelay = math.min(5 + (State.HopAttempts * 2), 15)
        StatusLabel.Text = string.format("No servers found. Retry in %ds", retryDelay)
        StatusLabel.TextColor3 = Color3.fromRGB(255, 69, 0)
        
        task.wait(retryDelay)
        State.IsHopping = false
        
        if State.HopAttempts > Config.MaxRetries then
            State.HopAttempts = 0
        end
    end)
end

