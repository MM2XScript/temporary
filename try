-- Block cache system
local BlockCache = {}
local CacheTimeout = 1

-- Optimized block checking
local function CheckBlock(block)
    if not block or not block.Parent then return false end
    
    local blockId = tostring(block)
    local currentTime = tick()
    
    if BlockCache[blockId] and (currentTime - BlockCache[blockId].time) < CacheTimeout then
        return BlockCache[blockId].result
    end
    
    if block:GetAttribute("Broken") or block:GetAttribute("Destroyed") then
        BlockCache[blockId] = {result = false, time = currentTime}
        return false
    end
    
    local healthAttributes = {"Health", "health", "HP", "hp"}
    for _, attr in ipairs(healthAttributes) do
        local hp = block:GetAttribute(attr)
        if hp ~= nil and tonumber(hp) <= 0 then
            BlockCache[blockId] = {result = false, time = currentTime}
            return false
        end
    end

    local nameStr = string.lower(block.Name):gsub("[%s_%-]", "")
    if string.find(nameStr, "onyx") or Config.TargetIDs[nameStr] then
        BlockCache[blockId] = {result = true, time = currentTime}
        return true
    end

    local attributeKeys = {"id", "Id", "ID", "Type", "BlockType", "Material"}
    for _, key in ipairs(attributeKeys) do
        local val = block:GetAttribute(key)
        if val then
            local strVal = string.lower(tostring(val)):gsub("[%s_%-]", "")
            if string.find(strVal, "onyx") or Config.TargetIDs[strVal] then 
                BlockCache[blockId] = {result = true, time = currentTime}
                return true
            end
        end
    end

    if (block:IsA("Model") or block:IsA("Folder")) and #block:GetChildren() == 0 then
        BlockCache[blockId] = {result = false, time = currentTime}
        return false
    end
    
    BlockCache[blockId] = {result = false, time = currentTime}
    return false
end
-- Master scanner function
local function UpdateMasterScanner()
    local currentTime = tick()
    if currentTime - State.LastScanTime < Config.ScanInterval then
        return
    end
    
    State.LastScanTime = currentTime
    local count = 0
    local firstPart, firstId = nil, nil
    local things = Workspace:FindFirstChild("__THINGS")
    
    if things then
        State.InMiningZone = true
        
        local function scanFolder(folder)
            for _, container in ipairs(folder:GetChildren()) do
                if container and container.Parent then
                    for _, block in ipairs(container:GetChildren()) do
                        if CheckBlock(block) then 
                            count = count + 1 
                            if not firstPart then
                                firstPart = block:FindFirstChildWhichIsA("BasePart", true)
                                firstId = block.Name
                                if count > 10 then break end
                            end
                        end
                    end
                end
                if count > 50 then break end
            end
        end
        
        local blockWorlds = things:FindFirstChild("BlockWorlds")
        if blockWorlds then 
            scanFolder(blockWorlds) 
        end
        
        if count < 20 then
            local breakables = things:FindFirstChild("Breakables")
            if breakables then 
                for _, block in ipairs(breakables:GetChildren()) do
                    if CheckBlock(block) then 
                        count = count + 1 
                        if not firstPart then
                            firstPart = block:FindFirstChildWhichIsA("BasePart", true)
                            firstId = block.Name
                        end
                    end
                    if count > 50 then break end
                end
            end
        end
    else 
        State.InMiningZone = false 
    end
    
    State.OnyxCount = count
    State.TargetPart = firstPart
    State.TargetId = firstId
    
    -- Cache cleanup
    local blockCacheKeys = {}
    for key, _ in pairs(BlockCache) do
        table.insert(blockCacheKeys, key)
    end
    
    if #blockCacheKeys > 100 then
        for i = 1, 20 do
            BlockCache[blockCacheKeys[i]] = nil
        end
    end
end

-- Main loop
task.spawn(function()
    while State.BootTimer > 0 do
        StatusLabel.Text = string.format("Initializing (%ds)...", math.ceil(State.BootTimer))
        StatusLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
        InfoBox.Text = string.format("Zone: Booting\nOnyx: 0\nHops: %d\nStatus: Preparing", State.TotalHops)
        task.wait(1)
        State.BootTimer = State.BootTimer - 1
    end
    
    State.IsBooting = false
    State.CurrentJitter = Config.BaseTimeout + (math.random(1, 15) / 10)
    
    while task.wait(Config.ScanInterval) do
        UpdateMasterScanner()
        
        if not State.InMiningZone then
            State.NoOnyxTimer = 0
            StatusLabel.Text = "Searching for mining zone..."
            StatusLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
        elseif State.OnyxCount > 0 then
            State.NoOnyxTimer = 0
            State.CurrentJitter = Config.BaseTimeout + (math.random(1, 15) / 10)
            StatusLabel.Text = string.format("Onyx detected (%d found)", State.OnyxCount)
            StatusLabel.TextColor3 = Color3.fromRGB(50, 205, 50)
        else
            State.NoOnyxTimer = State.NoOnyxTimer + Config.ScanInterval
            local timeLeft = math.max(0, State.CurrentJitter - State.NoOnyxTimer)
            StatusLabel.Text = string.format("No Onyx - Hop in %.1fs", timeLeft)
            StatusLabel.TextColor3 = Color3.fromRGB(255, 140, 0)
            
            if State.NoOnyxTimer >= State.CurrentJitter and Config.HopEnabled and not State.IsHopping then 
                HopServer() 
            end
        end
        
        local zoneStatus = State.InMiningZone and "Active" or "Inactive"
        local hopStatus = not Config.HopEnabled and "Auto Hop OFF" or 
                         (State.NoOnyxTimer > 0 and "Hop Scheduled" or "Monitoring")
        
        InfoBox.Text = string.format("Zone: %s\nOnyx: %d\nHops: %d\nStatus: %s", 
                                    zoneStatus, State.OnyxCount, State.TotalHops, hopStatus)
    end
end)

