-- Main loop (CPU optimized)
task.spawn(function()
    -- Boot sequence
    while State.BootTimer > 0 do
        Status.Text = string.format("Starting... %ds", State.BootTimer)
        Info.Text = string.format("Zone: Booting\nOres: 0 | Hops: %d", State.TotalHops)
        task.wait(1)
        State.BootTimer = State.BootTimer - 1
    end
    
    State.IsBooting = false
    
    -- Main scanning loop (reduced frequency for CPU)
    while task.wait(Config.ScanInterval) do
        ScanForOres()
        
        if not State.InMiningZone then
            State.NoOreTimer = 0
            Status.Text = "Searching mining zone..."
            Status.TextColor3 = Color3.fromRGB(255, 200, 100)
        elseif State.OreCount > 0 then
            State.NoOreTimer = 0
            Status.Text = string.format("Ores found: %d", State.OreCount)
            Status.TextColor3 = Color3.fromRGB(100, 255, 100)
        else
            State.NoOreTimer = State.NoOreTimer + Config.ScanInterval
            local timeLeft = Config.BaseTimeout - State.NoOreTimer
            Status.Text = string.format("No ores - hop in %.0fs", math.max(0, timeLeft))
            Status.TextColor3 = Color3.fromRGB(255, 150, 50)
            
            if State.NoOreTimer >= Config.BaseTimeout and Config.HopEnabled and not State.IsHopping then
                HopServer()
            end
        end
        
        Info.Text = string.format("Zone: %s\nOres: %d | Hops: %d", 
                                 State.InMiningZone and "Active" or "Inactive",
                                 State.OreCount, State.TotalHops)
    end
end)

-- Lightweight movement (reduced frequency)
task.spawn(function()
    while task.wait(Config.MovementInterval) do
        if Config.HopEnabled and not State.IsHopping and not State.IsBooting and State.TargetPart then
            pcall(function()
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("HumanoidRootPart") then
                    local hrp = character.HumanoidRootPart
                    local targetPos = State.TargetPart.CFrame * CFrame.new(0, 5, 0)
                    if (hrp.Position - targetPos.Position).Magnitude > 10 then
                        hrp.CFrame = targetPos
                    end
                end
            end)
        end
    end
end)

-- Lightweight damage dealing (reduced frequency)
task.spawn(function()
    local Network = ReplicatedStorage:WaitForChild("Network", 5)
    
    while task.wait(Config.DamageInterval) do
        if Config.HopEnabled and not State.IsHopping and not State.IsBooting and State.TargetId and Network then
            pcall(function()
                local dealDamage = Network:FindFirstChild("Breakables_PlayerDealDamage")
                if dealDamage and dealDamage:IsA("RemoteEvent") then
                    dealDamage:FireServer(State.TargetId)
                end
            end)
        end
    end
end)

