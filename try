-- Optimized ore detection (reduced CPU usage)
local function CheckOre(block)
    if not block or not block.Parent then return false end
    
    local name = string.lower(block.Name)
    for target, _ in pairs(Config.TargetIDs) do
        if string.find(name, target) then return true end
    end
    
    return false
end

-- CPU-friendly scanner (runs less frequently)
local function ScanForOres()
    local currentTime = tick()
    if currentTime - State.LastScan < Config.ScanInterval then return end
    State.LastScan = currentTime
    
    local count = 0
    local firstPart, firstId = nil, nil
    
    local things = Workspace:FindFirstChild("__THINGS")
    if things then
        State.InMiningZone = true
        
        -- Limit scanning to reduce CPU load
        local scanned = 0
        for _, container in pairs(things:GetChildren()) do
            for _, block in pairs(container:GetChildren()) do
                if CheckOre(block) then
                    count = count + 1
                    if not firstPart then
                        firstPart = block:FindFirstChildWhichIsA("BasePart")
                        firstId = block.Name
                    end
                end
                
                scanned = scanned + 1
                if scanned > 100 then break end -- Limit scanning for CPU
            end
            if scanned > 100 then break end
        end
    else
        State.InMiningZone = false
    end
    
    State.OreCount = count
    State.TargetPart = firstPart
    State.TargetId = firstId
end

-- Lightweight server hopper
local function HopServer()
    if State.IsHopping then return end
    State.IsHopping = true
    
    Status.Text = "Finding server..."
    Status.TextColor3 = Color3.fromRGB(255, 200, 100)
    
    task.spawn(function()
        local success, result = pcall(function()
            local url = string.format("https://games.roblox.com/v1/games/%s/servers/0?sortOrder=Asc&limit=50", PlaceId)
            return HttpService:JSONDecode(game:HttpGet(url))
        end)
        
        if success and result and result.data then
            local servers = {}
            for _, server in pairs(result.data) do
                if server.id ~= JobId and server.playing >= Config.MinPlayers and server.playing <= Config.MaxPlayers then
                    table.insert(servers, server.id)
                end
            end
            
            if #servers > 0 then
                State.TotalHops = State.TotalHops + 1
                Status.Text = "Teleporting..."
                pcall(function()
                    TeleportService:TeleportToPlaceInstance(PlaceId, servers[math.random(#servers)], LocalPlayer)
                end)
                task.wait(5)
            end
        end
        
        Status.Text = "Hop failed, retrying..."
        task.wait(3)
        State.IsHopping = false
    end)
end

